<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <!-- Android 12+: tested target range is Android 12–16. -->
        <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
        <ApplicationId>com.volumex</ApplicationId>
        <ApplicationVersion>2</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
        <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- arm64 for the phone, x64 for the emulator. -->
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
        <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
        <VolumeXKeyStore>$(HOME)/.android/volumebuster-release.keystore</VolumeXKeyStore>
        <VolumeXUploadKeyStore>$(HOME)/.android/volumebuster-upload.keystore</VolumeXUploadKeyStore>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' And Exists('$(VolumeXKeyStore)')">
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(VolumeXKeyStore)</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>volumebuster</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>file:$(HOME)/.android/volumebuster-release.pass</AndroidSigningStorePass>
        <AndroidSigningKeyPass>file:$(HOME)/.android/volumebuster-release.keypass</AndroidSigningKeyPass>
    </PropertyGroup>

    <PropertyGroup>
        <VolumeXSignBundleWithUploadKey Condition="'$(AndroidKeyStore)' == 'true' And Exists('$(VolumeXUploadKeyStore)')">true</VolumeXSignBundleWithUploadKey>
    </PropertyGroup>

    <Target Name="WarnDebugSignedRelease" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(AndroidKeyStore)' != 'true'">
        <Warning Text="Release keystore $(VolumeXKeyStore) not found: the package is signed with the debug key and is not fit for publishing." />
    </Target>

    <Target Name="WarnBundleWithoutUploadKey" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(AndroidKeyStore)' == 'true' And '$(VolumeXSignBundleWithUploadKey)' != 'true'">
        <Warning Text="Upload keystore $(VolumeXUploadKeyStore) not found: the bundle is signed with the app signing key and the stores will reject it." />
    </Target>

    <Target Name="UseUploadKeyForBundle" BeforeTargets="_Sign" DependsOnTargets="_ResolveAndroidSigningKey" Condition="'$(VolumeXSignBundleWithUploadKey)' == 'true' And '$(AndroidPackageFormat)' == 'aab'">
        <PropertyGroup>
            <_ApkKeyStore>$(VolumeXUploadKeyStore)</_ApkKeyStore>
            <_ApkKeyAlias>upload</_ApkKeyAlias>
            <_ApkStorePass>file:$(HOME)/.android/volumebuster-upload.pass</_ApkStorePass>
            <_ApkKeyPass>file:$(HOME)/.android/volumebuster-upload.pass</_ApkKeyPass>
        </PropertyGroup>
    </Target>

    <Target Name="UseAppSigningKeyForApk" BeforeTargets="_CreateUniversalApkFromBundle" Condition="'$(VolumeXSignBundleWithUploadKey)' == 'true' And '$(AndroidPackageFormat)' == 'aab'">
        <PropertyGroup>
            <_ApkKeyStore>$(AndroidSigningKeyStore)</_ApkKeyStore>
            <_ApkKeyAlias>$(AndroidSigningKeyAlias)</_ApkKeyAlias>
            <_ApkStorePass>$(AndroidSigningStorePass)</_ApkStorePass>
            <_ApkKeyPass>$(AndroidSigningKeyPass)</_ApkKeyPass>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\VolumeX\VolumeX.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
    </ItemGroup>
</Project>
