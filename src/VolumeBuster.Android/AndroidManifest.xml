<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The only permission: an audio effect on the global output. No network, so no ads and no analytics. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application android:label="VolumeBuster" android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon" />
</manifest>
